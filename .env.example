# Copy to .env and fill in. Never commit .env.

APP_ENV=local

# Postgres (docker-compose service "db") and Redis (service "redis")
DATABASE_URL=postgresql+psycopg://privtrace:privtrace@db:5432/privtrace
REDIS_URL=redis://redis:6379/0

# Gemini (optional). Without these, scans still run, just without AI explanations.
# Set GEMINI_MODEL to the Gemini model id you want to use.
GEMINI_API_KEY=
GEMINI_MODEL=
PRIVTRACE_AI_ENABLED=true

# Code-protection limits
PRIVTRACE_MAX_SNIPPET_LINES=40
PRIVTRACE_MAX_UPLOAD_MB=50

# Host port for the API (change if 8000 is busy)
PRIVTRACE_API_PORT=8000
