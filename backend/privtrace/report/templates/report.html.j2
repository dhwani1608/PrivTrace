<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PrivTrace report · {{ r.target }}</title>
<style>
  :root { --fg:#111827; --muted:#6b7280; --line:#e5e7eb; --bg:#ffffff; --soft:#f9fafb;
          --red:#dc2626; --amber:#d97706; --green:#1f9d55; --grey:#8a8f98; --blue:#2563eb; }
  * { box-sizing: border-box; }
  body { margin:0; font:14px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; color:var(--fg); background:var(--bg); }
  main { max-width: 1080px; margin: 0 auto; padding: 32px 20px 64px; }
  h1 { font-size: 26px; margin: 0 0 4px; }
  h2 { font-size: 19px; margin: 40px 0 12px; padding-bottom: 6px; border-bottom: 2px solid var(--line); }
  h3 { font-size: 16px; margin: 24px 0 8px; }
  a { color: var(--blue); }
  .muted { color: var(--muted); }
  .meta { color: var(--muted); font-size: 13px; }
  .banner { background:#fff7ed; border:1px solid #fed7aa; border-radius:8px; padding:10px 14px; font-size:13px; margin:16px 0; }
  .summary { display:flex; flex-wrap:wrap; gap:16px; align-items:stretch; margin-top:16px; }
  .card { border:1px solid var(--line); border-radius:10px; padding:14px 16px; background:var(--bg); }
  .gauge-card { text-align:center; min-width:150px; }
  .gauge-card .name { font-weight:600; margin-top:4px; }
  .gauge-card .cov { font-size:12px; color:var(--muted); max-width:170px; margin:4px auto 0; }
  .risk { font-size:22px; font-weight:700; }
  .risk.Critical { color:var(--red); } .risk.High { color:#ea580c; } .risk.Medium { color:var(--amber); } .risk.Low { color:var(--green); }
  .stats { display:grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap:10px; margin-top:12px; }
  .stat b { font-size:20px; display:block; }
  table { width:100%; border-collapse:collapse; font-size:13px; }
  th, td { text-align:left; padding:7px 8px; border-bottom:1px solid var(--line); vertical-align:top; }
  th { background:var(--soft); font-weight:600; }
  .badge { display:inline-block; padding:1px 8px; border-radius:999px; font-size:12px; font-weight:600; white-space:nowrap; }
  .sev-critical { background:#fee2e2; color:#991b1b; } .sev-high { background:#ffedd5; color:#9a3412; }
  .sev-medium { background:#fef3c7; color:#92400e; } .sev-low { background:#e0f2fe; color:#075985; }
  .st-failed { background:#fee2e2; color:#991b1b; } .st-passed { background:#dcfce7; color:#166534; }
  .st-needs_review { background:#fef3c7; color:#92400e; } .st-not_assessable { background:#f3f4f6; color:#4b5563; }
  .rule { border:1px solid var(--line); border-radius:10px; margin:12px 0; overflow:hidden; page-break-inside:avoid; }
  .rule > summary { list-style:none; cursor:pointer; padding:10px 14px; display:flex; gap:8px; align-items:center; flex-wrap:wrap; background:var(--soft); }
  .rule > summary::-webkit-details-marker { display:none; }
  .rule .body { padding:6px 16px 14px; }
  .rule .rid { font-family: ui-monospace, Consolas, monospace; font-size:12px; color:var(--muted); }
  .rule .title { font-weight:600; flex:1 1 300px; }
  .kv { display:grid; grid-template-columns: 140px 1fr; gap:4px 12px; margin:8px 0; font-size:13px; }
  .kv dt { color:var(--muted); }
  .kv dd { margin:0; }
  pre, code { font-family: ui-monospace, Consolas, "Courier New", monospace; font-size:12px; }
  pre { background:#0f172a; color:#e2e8f0; padding:10px 12px; border-radius:8px; overflow-x:auto; white-space:pre; }
  pre .add { color:#86efac; } pre .del { color:#fca5a5; } pre .hunk { color:#93c5fd; }
  .ev td:first-child { white-space:nowrap; font-family: ui-monospace, Consolas, monospace; }
  .ev code { background:var(--soft); padding:1px 4px; border-radius:4px; word-break:break-all; }
  .unverified { font-size:11px; color:#92400e; background:#fef3c7; border-radius:4px; padding:0 5px; margin-left:4px; }
  .ai-label { font-size:11px; color:#5b21b6; background:#ede9fe; border-radius:4px; padding:0 6px; }
  svg.flow .flow-h { font-size:12px; font-weight:700; fill:var(--muted); }
  svg.flow .node rect { fill:#f8fafc; stroke:#cbd5e1; }
  svg.flow .node.source rect { fill:#eff6ff; stroke:#93c5fd; }
  svg.flow .node.sink rect { fill:#fdf4ff; stroke:#d8b4fe; }
  svg.flow .node text { font-size:12px; fill:#111827; }
  svg.flow .edge { fill:none; stroke:#94a3b8; stroke-width:1.4; }
  svg.flow .edge.risky { stroke:var(--red); stroke-width:2.2; }
  .legend span { display:inline-block; margin-right:16px; font-size:12px; color:var(--muted); }
  .legend i { display:inline-block; width:22px; height:3px; vertical-align:middle; margin-right:6px; }
  .delta-up { color:var(--green); font-weight:700; } .delta-down { color:var(--red); font-weight:700; }
  footer { margin-top:48px; padding-top:16px; border-top:2px solid var(--line); font-size:12px; color:var(--muted); }
  @media print { .rule { break-inside: avoid; } details { display:block; } details > summary { display:flex; } .rule .body { display:block !important; } a { color: inherit; } }
</style>
</head>
<body>
<main>
  <header>
    <h1>PrivTrace compliance exposure report</h1>
    <div class="meta">Target <b>{{ r.target }}</b> · Scan <code>{{ r.scan_id }}</code> · {{ r.created_at.strftime("%Y-%m-%d %H:%M UTC") }} ·
      Frameworks: {% for p in r.pack_scores %}{{ p.short_name }}{% if not loop.last %}, {% endif %}{% endfor %}
      {% if r.ai_used %} · AI explanations: on{% endif %}</div>
    <div class="banner"><b>Not legal advice.</b> {{ r.disclaimer }}</div>
  </header>

  <!-- 1. Summary -->
  <section>
    <h2>1. Summary</h2>
    <div class="summary">
      <div class="card gauge-card">
        {{ gauge(r.overall_score, 140, "Overall") }}
        <div class="name">Overall</div>
        <div class="cov">Risk level</div>
        <div class="risk {{ r.risk_level.value }}">{{ r.risk_level.value }}</div>
      </div>
      {% for p in r.pack_scores %}
      <div class="card gauge-card">
        {{ gauge(p.score, 110, p.short_name) }}
        <div class="name">{{ p.short_name }}</div>
        <div class="cov">{{ p.coverage.automated_checked }} of {{ p.coverage.total }} rules checked automatically,
          {{ p.coverage.manual_answered }} answered manually, {{ p.coverage.not_assessable }} not assessable from code,
          {{ p.coverage.needs_review }} need review</div>
      </div>
      {% endfor %}
    </div>
    <div class="stats">
      <div class="card stat"><b>{{ r.summary.files_scanned }}</b><span class="muted">files scanned ({{ r.summary.python_files }} Python)</span></div>
      <div class="card stat"><b>{{ r.summary.models_with_pii }}</b><span class="muted">data models holding personal data</span></div>
      <div class="card stat"><b>{{ r.summary.pii_sinks }}</b><span class="muted">places personal data reaches a sink</span></div>
      <div class="card stat"><b style="color:var(--red)">{{ r.summary.risky_flows }}</b><span class="muted">risky flows (unredacted to AI, logs, third parties)</span></div>
    </div>

    {% if r.diff %}
    <h3>Changes since last scan</h3>
    {% set d = r.diff %}
    <p>Overall {{ d.overall_before if d.overall_before is not none else "n/a" }} → <b>{{ d.overall_after if d.overall_after is not none else "n/a" }}</b>
      {% if d.overall_delta is not none %}<span class="{{ 'delta-up' if d.overall_delta >= 0 else 'delta-down' }}">({{ "%+.1f"|format(d.overall_delta) }})</span>{% endif %}
      · Risk {{ d.risk_before }} → <b>{{ d.risk_after }}</b>
      <span class="muted">· compared with scan {{ d.previous_scan_id }} of {{ d.previous_target }}</span></p>
    <table>
      <tr><th>Framework</th><th>Before</th><th>After</th><th>Change</th></tr>
      {% for p in d.packs %}<tr><td>{{ p.short_name }}</td><td>{{ p.before if p.before is not none else "n/a" }}</td><td>{{ p.after if p.after is not none else "n/a" }}</td>
        <td>{% if p.delta is not none %}<span class="{{ 'delta-up' if p.delta >= 0 else 'delta-down' }}">{{ "%+.1f"|format(p.delta) }}</span>{% endif %}</td></tr>{% endfor %}
    </table>
    {% if d.fixed %}<p><b class="delta-up">Fixed ({{ d.fixed|length }}):</b> {% for f in d.fixed %}<code>{{ f.rule_id }}</code> {{ f.title }}{% if not loop.last %}; {% endif %}{% endfor %}</p>{% endif %}
    {% if d.regressed %}<p><b class="delta-down">New failures ({{ d.regressed|length }}):</b> {% for f in d.regressed %}<code>{{ f.rule_id }}</code> {{ f.title }}{% if not loop.last %}; {% endif %}{% endfor %}</p>{% endif %}
    {% if d.still_failing %}<p class="muted">Still failing: {{ d.still_failing|length }}</p>{% endif %}
    {% endif %}

    <h3>Top fixes</h3>
    {% if top %}
    <table>
      <tr><th>#</th><th>Severity</th><th>Issue</th><th>Where</th><th>Fix</th></tr>
      {% for t in top %}
      <tr><td>{{ loop.index }}</td><td><span class="badge sev-{{ t.severity.value }}">{{ t.severity.value }}</span></td>
        <td><a href="#{{ t.pack_id }}-{{ t.rule_id }}">{{ t.title }}</a></td>
        <td>{% if t.evidence %}<code>{{ t.evidence[0].file }}:{{ t.evidence[0].line }}</code>{% if t.evidence|length > 1 %} <span class="muted">+{{ t.evidence|length - 1 }}</span>{% endif %}{% endif %}</td>
        <td>{{ t.remediation }}</td></tr>
      {% endfor %}
    </table>
    {% else %}<p class="muted">No failed rules.</p>{% endif %}
  </section>

  <!-- 2. Data flow -->
  <section>
    <h2>2. Data-flow map</h2>
    <p class="muted">Where personal data enters the code, which functions carry it, and which stores or third parties it reaches. Hover an edge for file:line.</p>
    <div class="legend"><span><i style="background:var(--red)"></i>risky (unredacted to AI / logs / third parties / sensitive data)</span><span><i style="background:#94a3b8"></i>other flow</span></div>
    {{ flow }}
    {% if r.ai_classifications %}
    <h3>Possible personal data in generic fields <span class="ai-label">AI-classified — review</span></h3>
    <p class="muted">These generically named fields were classified by AI as likely holding personal data. They do not change any rule result.</p>
    <table>
      <tr><th>Field</th><th>Category</th><th>Where</th><th>Why</th></tr>
      {% for c in r.ai_classifications %}
      <tr><td><code>{{ c.name }}</code></td><td>{{ c.category }}</td><td>{% if c.file %}<code>{{ c.file }}:{{ c.line }}</code>{% endif %}</td><td>{{ c.reason }}</td></tr>
      {% endfor %}
    </table>
    {% endif %}
  </section>

  <!-- 3. Findings -->
  <section>
    <h2>3. Findings by framework</h2>
    {% for p in r.pack_scores %}
    <h3 id="{{ p.pack_id }}">{{ p.name }} — {{ p.score if p.score is not none else "n/a" }}{% if p.score is not none %}/100{% endif %}</h3>
    <p class="muted">{{ p.passed }} passed · {{ p.failed }} failed · {{ p.needs_review }} need review · {{ p.not_assessable }} not assessable</p>
    {% for x in by_pack[p.pack_id] %}
    <details class="rule" id="{{ x.pack_id }}-{{ x.rule_id }}" {% if x.status.value in ("failed", "needs_review") %}open{% endif %}>
      <summary>
        <span class="badge st-{{ x.status.value }}">{{ x.status.value.replace("_", " ") }}</span>
        <span class="badge sev-{{ x.severity.value }}">{{ x.severity.value }}</span>
        <span class="title">{{ x.title }}</span>
        <span class="rid">{{ x.rule_id }} · {{ x.check_type.value }}</span>
      </summary>
      <div class="body">
        <p>{{ x.message }}</p>
        <dl class="kv">
          <dt>Legal reference</dt>
          <dd>{{ x.reference }} {% if not x.reference_verified %}<span class="unverified" title="Citation awaiting human verification">unverified</span>{% endif %}
            · <a href="{{ x.source_url }}" target="_blank" rel="noopener">source</a></dd>
          <dt>Why it matters</dt><dd>{{ x.why_it_matters }}</dd>
          <dt>How to fix</dt><dd>{{ x.remediation }}</dd>
          {% if x.question %}<dt>Checklist</dt><dd>{{ x.question }} — <b>{{ x.manual_answer.value.replace("_", " ") if x.manual_answer else "not answered" }}</b></dd>{% endif %}
        </dl>
        {% if x.evidence %}
        <table class="ev">
          <tr><th>Location</th><th>Evidence (redacted)</th></tr>
          {% for e in x.evidence %}
          <tr><td>{{ e.file }}:{{ e.line }}</td><td>{% if e.snippet %}<code>{{ e.snippet }}</code><br>{% endif %}<span class="muted">{{ e.detail }}</span></td></tr>
          {% endfor %}
        </table>
        {% endif %}
        {% if x.ai and x.ai.explanation %}
        <p><span class="ai-label">AI explanation</span> {{ x.ai.explanation }}</p>
        {% endif %}
        {% if x.fix_diff %}
        <p><b>Suggested change</b> <span class="muted">(template-generated, review before applying)</span></p>
        <pre>{% for line in x.fix_diff.splitlines() %}{% if line.startswith("+++") or line.startswith("---") %}<span class="hunk">{{ line }}</span>{% elif line.startswith("+") %}<span class="add">{{ line }}</span>{% elif line.startswith("-") %}<span class="del">{{ line }}</span>{% elif line.startswith("@@") %}<span class="hunk">{{ line }}</span>{% else %}{{ line }}{% endif %}
{% endfor %}</pre>
        {% elif x.ai and (x.ai.suggested_diff or x.ai.suggested_fix) %}
        <p><b>Suggested change</b> <span class="ai-label">AI-suggested — review before applying</span></p>
        {% if x.ai.suggested_fix %}<p>{{ x.ai.suggested_fix }}</p>{% endif %}
        {% if x.ai.suggested_diff %}<pre>{{ x.ai.suggested_diff }}</pre>{% endif %}
        {% endif %}
      </div>
    </details>
    {% endfor %}
    {% endfor %}
  </section>

  <!-- 4. Manual checklist -->
  <section>
    <h2>4. Manual checklist answers</h2>
    {% if manual %}
    <table>
      <tr><th>Rule</th><th>Question</th><th>Answer</th><th>Result</th></tr>
      {% for m in manual %}
      <tr><td><code>{{ m.rule_id }}</code></td><td>{{ m.question }}</td>
        <td>{{ m.manual_answer.value.replace("_", " ") if m.manual_answer else "—" }}</td>
        <td><span class="badge st-{{ m.status.value }}">{{ m.status.value.replace("_", " ") }}</span></td></tr>
      {% endfor %}
    </table>
    {% else %}<p class="muted">No checklist questions for the selected frameworks.</p>{% endif %}
  </section>

  <!-- 5. Coverage -->
  <section>
    <h2>5. Coverage and limitations</h2>
    <table>
      <tr><th>Framework</th><th>Rules</th><th>Checked automatically</th><th>Answered manually</th><th>Need review</th><th>Not assessable from code</th></tr>
      {% for p in r.pack_scores %}
      <tr><td>{{ p.name }}</td><td>{{ p.coverage.total }}</td><td>{{ p.coverage.automated_checked }}</td><td>{{ p.coverage.manual_answered }}</td><td>{{ p.coverage.needs_review }}</td><td>{{ p.coverage.not_assessable }}</td></tr>
      {% endfor %}
    </table>
    <ul class="muted">
      <li>Only Python source is analysed in depth; other files get identifier, secret and configuration checks.</li>
      <li>Data-flow tracking is intra-function plus calls into repo modules (3 levels). Dynamic dispatch, <code>**kwargs</code>, data read back from databases and infrastructure configuration are not followed.</li>
      <li>Consent, minimisation, children's data and third-party sharing are heuristics: they produce "needs review", never "failed".</li>
      <li>Rules marked <span class="unverified">unverified</span> cite a legal provision that has not yet been checked by a human against the official text.</li>
      <li>Evidence snippets and suggested diffs are redacted; values like Aadhaar, PAN, phone, email and keys appear as <code>[REDACTED:…]</code>.</li>
    </ul>
  </section>

  <!-- 6. Disclaimer -->
  <section>
    <h2>6. Disclaimer</h2>
    <p>{{ r.disclaimer }}</p>
  </section>

  <footer>
    <b>How the score is calculated.</b> {{ r.scoring_formula }}<br>
    Generated by PrivTrace · scan {{ r.scan_id }}
  </footer>
</main>
</body>
</html>
